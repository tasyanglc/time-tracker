<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_menu" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Momentum"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_launcher_foreground"
                android:background="@color/accent_olive"
                app:shapeAppearanceOverlay="@style/CircleImageView" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reports"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnExport"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:backgroundTint="@color/accent_yellow"
                android:text="Export Data"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:icon="@drawable/lucide__1_"
                app:iconSize="16dp"
                app:iconTint="@color/text_primary" />
        </RelativeLayout>

        <!-- Toggle Tabs -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:checkedButton="@+id/btnWeekly"
            app:singleSelection="true"
            app:selectionRequired="true">
            <Button
                android:id="@+id/btnDaily"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Daily" />
            <Button
                android:id="@+id/btnWeekly"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Weekly" />
            <Button
                android:id="@+id/btnMonthly"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Monthly" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Time Distribution Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time Distribution"
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Mock Donut Chart -->
                <FrameLayout
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:layout_marginVertical="24dp">
                    <ProgressBar
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="false"
                        android:progress="100"
                        android:progressDrawable="@drawable/donut_bg"
                        style="?android:attr/progressBarStyleHorizontal" />

                    <!-- Multi-colored segments -->
                    <ProgressBar
                        android:id="@+id/pbFocus"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="false"
                        android:progress="50"
                        android:progressDrawable="@drawable/donut_segment_focus" />

                    <ProgressBar
                        android:id="@+id/pbAdmin"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="false"
                        android:progress="25"
                        android:progressDrawable="@drawable/donut_segment_admin" />

                    <ProgressBar
                        android:id="@+id/pbLeisure"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="false"
                        android:progress="15"
                        android:progressDrawable="@drawable/donut_segment_leisure" />

                    <ProgressBar
                        android:id="@+id/pbHealth"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="false"
                        android:progress="10"
                        android:progressDrawable="@drawable/donut_segment_health" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvTotalTimeReports"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="32.5h"
                            android:textColor="@color/text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total"
                            android:textColor="#555555"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <GridLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:columnCount="2">

                    <TextView
                        style="@style/ChartLegend"
                        android:layout_width="wrap_content"
                        android:paddingEnd="16dp"
                        android:text="Focus"
                        app:drawableStartCompat="@drawable/dot_yellow" />

                    <TextView
                        style="@style/ChartLegend"
                        android:layout_width="wrap_content"
                        android:paddingEnd="16dp"
                        android:text="Admin"
                        app:drawableStartCompat="@drawable/dot_gray" />

                    <TextView
                        style="@style/ChartLegend"
                        android:layout_width="wrap_content"
                        android:paddingEnd="16dp"
                        android:text="Leisure"
                        app:drawableStartCompat="@drawable/dot_light_gray" />

                    <TextView
                        style="@style/ChartLegend"
                        android:layout_width="wrap_content"
                        android:paddingEnd="16dp"
                        android:text="Health"
                        app:drawableStartCompat="@drawable/dot_olive" />
                </GridLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Weekly Trend Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weekly Trend"
                        android:textColor="#555555"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="+12% vs last week"
                        android:textColor="@color/accent_olive"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Mock Bar Chart -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="24dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">
                    <View style="@style/BarChartItem" android:layout_height="40dp" />
                    <View style="@style/BarChartItem" android:layout_height="60dp" />
                    <View style="@style/BarChartItem" android:layout_height="50dp" />
                    <View style="@style/BarChartItem" android:layout_height="90dp" android:backgroundTint="@color/accent_yellow" />
                    <View style="@style/BarChartItem" android:layout_height="70dp" />
                    <View style="@style/BarChartItem" android:layout_height="45dp" />
                    <View style="@style/BarChartItem" android:layout_height="30dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <TextView style="@style/BarChartLabel" android:text="MON" />
                    <TextView style="@style/BarChartLabel" android:text="TUE" />
                    <TextView style="@style/BarChartLabel" android:text="WED" />
                    <TextView style="@style/BarChartLabel" android:text="THU" />
                    <TextView style="@style/BarChartLabel" android:text="FRI" />
                    <TextView style="@style/BarChartLabel" android:text="SAT" />
                    <TextView style="@style/BarChartLabel" android:text="SUN" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="By Category"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:listitem="@layout/item_category" />

        <!-- Banner -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/accent_yellow"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keep it up!"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="You were 15% more focused this week compared to last. Wednesday was your peak performance day."
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>